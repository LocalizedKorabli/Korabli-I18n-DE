msgid "IDS_PCEE066_SUPREMACY_LEAGUE_WINNER"
msgstr "Meister der Supremacy League"

msgid "IDS_PCEE066_SUPREMACY_LEAGUE_WINNER_DESCRIPTION"
msgstr "Never gonna give you up, never gonna let you down. Never gonna run around and desert you. Never gonna make you cry, never gonna say goodbye. Never gonna tell a lie and hurt you."

