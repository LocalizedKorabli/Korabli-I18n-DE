msgstr "M. Richthofen (EM)"

msgid "IDS_PGSA990_DESCR"
msgstr "Eine Kopie des Schiffs zum Testen der Elite-Verbesserung."

msgid "IDS_PGSA990_FULL"
msgstr "Manfred von Richthofen (EM)"

