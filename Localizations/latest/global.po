msgstr "Cimarron"

msgid "IDS_PASC802_DESCR"
msgstr "Im Einführungsauftrag verwendeter Kreuzer Cimarron"

msgid "IDS_PASC803"
msgstr "Cimarron"

msgid "IDS_PASC803_DESCR"
msgstr "Im Einführungsauftrag verwendeter Kreuzer Cimarron"

msgid "IDS_PASC804"
msgstr "Erie"

msgid "IDS_PASC804_DESCR"
msgstr "Im Einführungsauftrag verwendeter Kreuzer Erie"

