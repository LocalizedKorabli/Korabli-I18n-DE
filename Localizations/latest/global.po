msgid "IDS_PCEE077_MARTOBOI_DESCRIPTION"
msgstr "Für Ihre Unterstützung und Teilnahme am Turnier „March Charge“."

msgid "IDS_PCEE078_OKHOTNIK"
msgstr "Ochotnik"

msgid "IDS_PCEE078_OKHOTNIK_DESCRIPTION"
msgstr "Der Jäger pirscht sich leise an seine Beute heran und schlägt erst zu, wenn der Sieg gewiss ist."

msgid "IDS_PCEE079_SCAVENGER"
msgstr "Die Früchte Ihrer Bemühungen"

msgid "IDS_PCEE079_SCAVENGER_DESCRIPTION"
msgstr "Sie sind den Hinweisen gefolgt! Lassen Sie Ihre Mit-Kapitäne wissen, dass Sie Ihre Zeit sinnvoll genutzt haben, indem Sie diese Flagge hissen!"

