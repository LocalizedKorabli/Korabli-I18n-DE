msgid "IDS_PCEE069_FIRE_ROOSTER"
msgstr "Feuerhahn"

msgid "IDS_PCEE069_FIRE_ROOSTER_DESCRIPTION"
msgstr "Zur Feier des Jahres 4714 im chinesischen Kalender – dem Jahr des Feuerhahns."

msgid "IDS_PCEE070_CHINESE_NEW_YEAR"
