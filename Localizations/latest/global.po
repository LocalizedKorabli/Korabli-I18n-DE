msgid "IDS_THIS_SHIP_IS_NOT_ALLOWED_FOR_EVENT"
msgstr "Das von Ihnen gewählte Schiff ist für den aktuell gewählten Gefechtstyp ungeeignet."

msgid "IDS_THIS_SHIP_IS_NOT_ALLOWED_FOR_OPERATION"
msgstr "Das gewählte Schiff ist im Unternehmen nicht erlaubt"

msgid "IDS_THIS_SHIP_IS_NOT_ALLOWED_FOR_TOURNAMENT"
msgstr "Das gewählte Schiff ist in einem Turniergefecht nicht erlaubt"

msgid "IDS_THIS_SHIP_IS_NOT_ALLOWED_FOR_TRAINING"
msgstr "Das gewählte Schiff ist in einem Übungsgefecht nicht erlaubt"

msgid "IDS_THIS_SHIP_IS_NOT_ALLOWED_FOR_TRIAL"
msgstr "Das ausgewählte Schiff ist nicht für Trainingsprüfungen geeignet."

