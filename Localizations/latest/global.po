msgid "IDS_MODAL_WINDOW_CLANBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Belohnungen"

msgid "IDS_MODAL_WINDOW_CLANBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können verschiedene Belohnungen erhalten, die von der Liga Ihres Clans und Ihrem persönlichen Beitrag abhängen."

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_HEADER"
msgstr "Co-op-Gefecht"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie kämpfen Seite an Seite mit anderen Spielern gegen ein Team aus Bots. Die Karte und der Gefechtsmodus werden zufällig ausgewählt."

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmeregeln"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Die maximale Teamgröße hängt von den Stufen der Schiffe ab:"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "• Stufen I–III: 6 gegen 6;"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "• Stufe IV: 6 gegen 6 oder 9 gegen 9;"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_4"
msgstr "• Stufen V–X und Superschiffe: 9 gegen 9."

msgid "IDS_MODAL_WINDOW_CREW_INFO_HEADER"
msgstr "FERTIGKEITEN IM DETAIL"

msgid "IDS_MODAL_WINDOW_CREW_MANAGEMENT_ABILITIES_HEADER"
msgstr "KAPITÄNSFERTIGKEITEN"

msgid "IDS_MODAL_WINDOW_CREW_MANAGEMENT_ASSIGN_HEADER"
msgstr "KAPITÄN ZUWEISEN"

msgid "IDS_MODAL_WINDOW_CREW_PERSONAL_FILE"
msgstr "PERSÖNLICHE AKTE"

msgid "IDS_MODAL_WINDOW_DOG_TAG_HEADER"
msgstr "Auswahl der Erkennungsmarke"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "GEGNER"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Zerstöre Bots auf Schiffen aus der Ära der Panzerschiffe. Die Anzahl der Gegner steigt ständig!"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "BUFFS"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "An den Stellen einiger zerstörter Gegner erscheinen Buffs. Sammeln Sie diese, solange sie verfügbar sind!"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "ZERSTÖRUNG DER PANZERUNG"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Panzerung wird durch Schaden zerstört."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Wenn ein Panzerungssektor vollständig zerstört ist, kann ein Geschoss eine verwundbare Stelle des Schiffs treffen und erheblichen Schaden verursachen."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "HAUPT- UND MITTLERER KALIBER"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Die Hauptbatterie verursacht hohen Schaden, hat aber eine lange Ladezeit."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Der mittlere Kaliber lädt schneller nach, verursacht aber weniger Schaden."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Respawns"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Zerstörte Zerstörer kehren ins Gefecht zurück, wenn im Team noch mindestens ein Schlachtschiff oder Kreuzer vorhanden ist."

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_LINK_HINT"
msgstr "Bonuspaket zuweisen"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_PURCHASE_HINT"
msgstr "Bonuspaket kaufen"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_UNAVAILABLE_HINT"
msgstr ""
"Für dieses Schiff\n"
"nicht verfügbar"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_EXPENDABLE_DESC"
msgstr "Angebrachte verbrauchbare Boni werden mit jedem Gefecht verbraucht."

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_EXPENDABLE_HEADER"
msgstr "Verbrauchbare Boni"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_OTHER_DESC"
msgstr "Boni für den ersten Tagessieg auf dem Schiff sowie andere Boni."

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_OTHER_HEADER"
msgstr "Weitere Boni"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_PERMANENT"
msgstr "Permanente Boni"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CATEGORY_PERMANENT_DESC"
msgstr "Wird einmal am Schiff angebracht und verbraucht sich nicht im Gefecht."

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CENTRAL_BLOCK_CARD_INSTALL_HINT_CREDITS"
msgstr "Bonus auf Silber"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CENTRAL_BLOCK_CARD_INSTALL_HINT_CREW_EXP"
msgstr "Bonus auf Kapitäns-EP"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CENTRAL_BLOCK_CARD_INSTALL_HINT_EXP"
msgstr "Bonus auf Schiffs-EP"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CENTRAL_BLOCK_CARD_INSTALL_HINT_FREE_EXP"
msgstr "Bonus auf freie EP"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_CENTRAL_BLOCK_CARD_OUT_OF_STOCK_HINT"
msgstr "Gewählter Bonus nicht verfügbar"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_EXPENDABLE_AUTOINSTALL"
msgstr "Automatisch anbringen"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_EXPENDABLE_INSTALL"
msgstr "Alle anbringen"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_EXPENDABLE_UNMOUNT_ALL"
msgstr "Alle entfernen"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_UNAVAILABLE_FOR_THAT_SHIP"
msgstr "Für dieses Schiff sind keine ökonomischen Boni verfügbar."

msgid "IDS_MODAL_WINDOW_ESCAPE_TO_PORTAL_RESULTS_TITLE"
msgstr "Ergebnis des Angriffs"

msgid "IDS_MODAL_WINDOW_EVENTBATTLE_RULES_HEADER"
msgstr "Regeln"

msgid "IDS_MODAL_WINDOW_EVENTBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_EVENTBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie müssen alle gegnerischen Schiffe zerstören."

msgid "IDS_MODAL_WINDOW_EVENT_FINISHED"
msgstr "Ergebnisse des Wettbewerbs"

msgid "IDS_MODAL_WINDOW_EVENT_RULES_HEADER"
msgstr "Eventregeln des Großgefechts"

msgid "IDS_MODAL_WINDOW_EVENT_RULES_PARAGRAPH_1_HEADER"
msgstr "Merkmale"

msgid "IDS_MODAL_WINDOW_EVENT_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Gefechte werden mit Schiffen der Stufen IX und X sowie mit den Superschlachtschiffen von Japan und Deutschland ausgetragen. Die Anzahl der Superschlachtschiffe pro Team ist begrenzt."

msgid "IDS_MODAL_WINDOW_EVENT_RULES_PARAGRAPH_2_HEADER"
msgstr "Geheimdienstberichte"

msgid "IDS_MODAL_WINDOW_EVENT_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Für jedes mit Schiffen der Stufen IX und X gespielte Großgefecht erhalten Sie 3 Geheimdienstberichte."

msgid "IDS_MODAL_WINDOW_EVENT_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Sammeln Sie die benötigte Anzahl an Geheimdienstberichten, um in nachfolgenden Gefechten die neuen Superschlachtschiffe auf einer Testfahrt zu steuern."

msgid "IDS_MODAL_WINDOW_HEADER_ELITE_CREW_ACADEMY"
msgstr "Elite-Ausbildung"

msgid "IDS_MODAL_WINDOW_LEARNSKILLS_HEADER"
msgstr "Meistern von Kapitänsfertigkeiten"

msgid "IDS_MODAL_WINDOW_LINK_DECAL_HEADER"
msgstr "Zuweisung des Decals"

msgid "IDS_MODAL_WINDOW_LINK_DECAL_INFO"
msgstr "Um ein solches Decal auf einem anderen Schiff anzubringen, muss man eine weitere Kopie erhalten."

msgid "IDS_MODAL_WINDOW_LINK_DECAL_TO"
msgstr "Dem Schiff zuweisen"

msgid "IDS_MODAL_WINDOW_LINK_DECAL_UNIQUE_INFO"
msgstr "Einzigartige Decals sind nicht käuflich zu erwerben."

msgid "IDS_MODAL_WINDOW_LINK_MULTIBOOST"
msgstr "Boni zuweisen"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_HEADER"
msgstr "Forschungsbüro"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_1_HEADER"
msgstr "Warum Forschungszweige zurücksetzen?"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Wenn Sie einen Forschungszweig zurücksetzen und die Schiffe dann erneut erforschen und kaufen, können Sie Forschungspunkte erhalten."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Diese Ressource kann in der Waffenkammer gegen besondere und Premiumschiffe, Eliteverbesserungen und besondere Gefechtssignale eingetauscht werden."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_2_HEADER"
msgstr "Was wird aus den Schiffen?"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Nach dem Zurücksetzen des Zweigs sind die Schiffe und Module nicht mehr erforscht und werden gegen Silber verkauft, und die EP des gesamten Zweigs werden auf das Schiff der Stufe I übertragen."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Alle anderen auf den Schiffen eingebauten oder ihnen zugewiesenen Gegenstände bleiben erhalten. Verbesserungen werden kostenlos ausgebaut."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_3_HEADER"
msgstr "Wie erhält man Punkte?"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Auf jedes zurückgesetzte Schiff der Stufen V–X werden Forschungspunkte gutgeschrieben."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Um sie zu erhalten, müssen Sie das Schiff erneut erforschen, kaufen, dann mit ihm in ein Gefecht gehen und gewinnen oder 300 Basis-EP verdienen."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_4_HEADER"
msgstr "Saisons und wiederholte Resets"

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Alle 90 Tage ändert sich im Forschungsbüro die Saison. Für den ersten Reset eines Zweigs in der Saison erhalten die Schiffe doppelt so viele Forschungspunkte."

msgid "IDS_MODAL_WINDOW_PARAGONS_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Sie können mit freien EP erforschen und den Zweig mehrmals zurücksetzen. Wenn Sie diese Schiffe kaufen, können Sie die über mehrere Resets angesammelten Forschungspunkte erhalten."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_HEADER"
msgstr "Wüstes Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_1_TEXT_1"
msgstr "An den Gefechten nehmen vier Teams mit jeweils drei Schiffen teil. Für ein Team, dessen Schiffe alle völlig zerstört wurden, ist das Gefecht vorbei. Sobald ein Team vom Gefecht ausgeschlossen wird, beeinflusst das die Platzierung in der Hauptergebnistabelle. Das letzte überlebende Team gewinnt das Gefecht. Die Platzierung eines Teams bestimmt, welche Menge an EP und Silbern seine Mitglieder verdienen."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Der Kampfbereich ist von einem kreisförmigen Lauffeuer umgeben, das sich immer weiter zusammenzieht und schließlich alle Gefechtsteilnehmer in Nahkämpfe zwingt. Schiffe, die sich im Lauffeuer aufhalten, erleiden kontinuierlich Schaden. An allen Schiffsbugen sind Sägen installiert, die die Effektivität von Rammangriffen erhöhen."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Alle Schiffe beginnen das Gefecht ohne Verbrauchsmaterialien. Verbrauchsmaterialien werden im Gefechtsverlauf von Flugzeugen abgeworfen. Hat ein Schiff ein abgeworfenes Verbrauchsmaterial aufgenommen, erhalten alle verbündeten Schiffe eine Ladung für ein verfügbares Verbrauchsmaterial. Ein Schiff erhält für jedes zerstörte Gegnerschiff eine Ladung für ein zufälliges Verbrauchsmaterial."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_HEADER"
msgstr "Fraktionen und Schiffe"

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Im Modus „Wüstes Gefecht“ gibt es drei Fraktionen: Oktopus, Muräne und Barrakuda. Die Schiffe jeder Fraktion verfügen über besondere Merkmale:"

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Die Schiffe der Oktopus-Fraktion sind schwer zu entdecken und haben eine schlagkräftige Torpedobewaffnung, dafür aber keine Hauptbatteriegeschütze."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Die Schiffe der Muräne-Fraktion sind wendig und stärker im Nahkampf, aber sie haben keine Hauptbatteriegeschütze."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_TEXT_4"
msgstr "Die Schiffe der Barrakuda-Fraktion sind schnell und haben schlagkräftige Hauptbatteriegeschütze, aber ihre Torpedobewaffnung verursacht wenig Schaden und hat eine lange Ladezeit."

msgid "IDS_MODAL_WINDOW_PCVE004_RULES_PARAGRAPH_2_TEXT_5"
msgstr "Die Schiffe aller Fraktionen haben drei Stufen: VIII, IX und X. Zu Beginn des Events erhalten Spieler Stufe-VIII-Schiffe. Die Schiffe der Stufen IX und X sind durch das Abschließen von Kampfaufträgen erhältlich."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_HEADER"
msgstr "Regeln für Asymmetrische Gefechte"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_1_HEADER"
msgstr "Regeln und Merkmale"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Eventdauer: 14 Tage."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_1_TEXT_2"
msgstr "In einem asymmetrischen Gefecht treten Teams mit unterschiedlicher Schiffsanzahl gegeneinander an."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Es sind nur Schiffe der Stufen VII–X erlaubt."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_2_HEADER"
msgstr "Gefechtsmarken"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Durch die Teilnahme an asymmetrischen Gefechten mit Schiffen der Stufen VII–VIII können Sie Gefechtsmarken verdienen, mit denen Sie den Zugang zu Schiffen der Stufen IX und X in diesem Gefechtstyp freischalten können."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Zur Gefechtsteilnahme mit einem bestimmten Schiff müssen Sie Gefechtsmarken zum Erhalt eines Befehls einsetzen."

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_HEADER"
msgstr "Hinzufügen von Gefechtsmarken"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Wie viele Marken Sie verdienen, hängt von der Stufe Ihres Schiffs ab:"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Stufe VII: 200 Marken pro Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_TEXT_3"
msgstr "Stufe VIII: 200 Marken pro Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_TEXT_4"
msgstr "Stufe IX: 0 Marken pro Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE007_RULES_PARAGRAPH_3_TEXT_5"
msgstr "Stufe X: 0 Marken pro Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_HEADER"
msgstr "Regeln der Zwielichtjagd"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_1_TEXT_1"
msgstr "In den Gefechten der Zwielichtjagd treten 16 Spieler gegeneinander an. Bei Gefechtsbeginn sind Sie ganz auf sich allein gestellt, aber im Verlauf der Schlacht können Sie Teams mit anderen Spielern bilden. Im Gefecht treffen Sie auch auf Schiffe der Zwielichtflotte."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Zu Beginn des Events haben Sie sofort Zugang zu sechs Schiffen der Zwielichtjagd. Außerdem können Sie im Verlauf des Events Kampfaufträge abschließen und grimmige Seemonster erhalten, um mit diesen ins Gefecht zu ziehen."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_2_HEADER"
msgstr "Eventabschnitte"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Das Event ist auf drei Abschnitte verteilt, die jeweils eine Woche dauern."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Jeder Abschnitt erhöht den Schwierigkeitsgrad der Gefechte, aber gleichzeitig werden auch die Belohnungen für das Zerstören der Schiffe der Zwielichtflotte immer verlockender."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Jeder neue Abschnitt erhöht auch die Höchstzahl an Spielern pro Team von drei auf bis zu sechs Spieler."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_3_HEADER"
msgstr "Belohnung"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Ihr Hauptziel besteht darin, so viele Gefechtspunkte wie möglich zu sammeln. Sie benötigen sie für den Fortschritt in Kampfaufträgen."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Sie können Gefechtspunkte verdienen, indem Sie die Schiffe der Zwielichtflotte zerstören. Wenn Sie ein Schiff eines anderen Spielers zerstören, erhalten Sie alle von diesem Spieler im aktuellen Gefecht verdienten Gefechtspunkte."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_3_TEXT_3"
msgstr "Einige Zeit nach Gefechtsbeginn erscheint Rasputin, das Flaggschiff der Zwielichtflotte, das nach Beute Ausschau hält. Zerstören Sie das finstere Schlachtschiff, um die maximalen Gefechtspunkte zu erhalten. Verlassen Sie das Gefecht durch das Portal, verdoppeln Sie damit die Anzahl der von Ihnen verdienten Gefechtspunkte."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_4_HEADER"
msgstr "Teams"

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Im Gefechtsverlauf können Teams gebildet werden. Es ist jederzeit erlaubt, ein Team zu verlassen."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Ein Team bietet beachtliche Vorteile im Gefecht, allerdings werden alle verdienten Gefechtspunkte zu gleichen Teilen auf alle Teammitglieder verteilt."

msgid "IDS_MODAL_WINDOW_PCVE009_RULES_PARAGRAPH_4_TEXT_3"
msgstr "Sie können einem Gefecht auch in einer Division beitreten, die sie im Hafen zusammengestellt haben. Veränderungen von Teams haben keine Auswirkungen auf die Zusammensetzung Ihrer Division."

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_HEADER"
msgstr "Regeln für das Wettrüsten"

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_PARAGRAPH_1_HEADER"
msgstr "Buffs"

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sammeln Sie Buffs auf, um die Gefechtseigenschaften der Schiffe und Staffeln Ihres Teams zu verbessern."

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_PARAGRAPH_2_HEADER"
msgstr "Schlüsselbereich"

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Erobern Sie den Schlüsselbereich, um mehr Punkte zu verdienen."

msgid "IDS_MODAL_WINDOW_PCVE016_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Einige Zeit nach Gefechtsbeginn erscheint ein Schlüsselbereich. Der Eroberungsbereich wird schrittweise kleiner."

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_HEADER"
msgstr "Konvoi"

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Wenn Sie einem Gefecht beitreten, werden Sie nach dem Zufallsprinzip entweder dem Angreifer- oder dem Verteidigerteam zugewiesen."

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Das Verteidigerteam hat den Auftrag, entweder die sichere Ankunft von mindestens einem Transportschiff am Zielpunkt sicherzustellen oder alle Schiffe des Angreiferteams zu zerstören."

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Das Angreiferteam hat den Auftrag, entweder die sichere Ankunft der Transportschiffe am Zielpunkt zu verhindern oder alle Schiffe des Verteidigerteams zu zerstören."

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Ein Gefecht besteht aus zwei Teams mit je 12 Schiffen. Sie können entweder allein oder in einer Division mit bis zu drei Teilnehmern ins Gefecht ziehen."

msgid "IDS_MODAL_WINDOW_PCVE017_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Schiffe der Stufen VIII–X können teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_HEADER"
msgstr "Regeln für Zwielichtgefechte"

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Im Zwielichtgefecht treten zwei Teams in einem zeitlich unbegrenzten Konflikt gegeneinander an. Um zu gewinnen, muss ein Team alle Schiffe des Gegnerteams zerstören."

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Die vom Schmutz umgebene Kampfzone wird kontinuierlich kleiner. Gerät das Schiff eines Spielers in den Schmutz, erleidet es kontinuierlich Schaden. Die Schadensmenge hängt vom Schiffstyp ab."

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE018_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Es treten Teams aus je sieben Spielern am Steuer von Stufe-IX-Schiffen gegeneinander an, die mit speziellen Verbrauchsmaterialien ausgerüstet sind. Diese Schiffe wurden speziell für dieses Event entworfen."

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_HEADER"
msgstr "Ärger im Pool"

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Zwischen den Gummienten, die durch das Wasser in Caps Pool pflügen, ist ein erbittertes Scharmützel entbrannt."

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Offenbar sind die Enten mit Zähnen (besser gesagt, mit Schnäbeln!) ausgerüstet. Sogar Seeminen sind im Spiel – eine praktische Möglichkeit, Gegner in Schach zu halten! Und wenn es eine der flinken Enten schafft, sich ihrem Gegner zu nähern, prallt sie vielleicht vom nächsten aufblasbaren Spielzeug ab!"

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_2_TEXT_1"
msgstr "An den Gefechten nehmen zwei Teams mit jeweils sieben Enten teil."

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Die Gefechte werden mit Stufe-X-Enten und mit Superenten ausgetragen – sie alle gibt es nur in diesem Event."

msgid "IDS_MODAL_WINDOW_PCVE019_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Kämpfen Sie ohne viel Federlesen!"

msgid "IDS_MODAL_WINDOW_PCVE020_RULES_HEADER"
msgstr "Asymmetrisches Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE020_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE020_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie kämpfen zusammen mit anderen Spielern gegen Bots. Der Gegner ist Ihnen zahlenmäßig überlegen, aber in der Kampfkraft unterlegen."

msgid "IDS_MODAL_WINDOW_PCVE020_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmeregeln"

msgid "IDS_MODAL_WINDOW_PCVE020_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können allein oder in einer Division ins Gefecht ziehen."

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_HEADER"
msgstr "Verdeckte Manöver"

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_1_TEXT_1"
msgstr "An den Gefechten können Flugzeugträger teilnehmen, die eine besondere taktische Rolle einnehmen. Die Schlachtflugzeuge des Trägers Taihō können eine Nebelwand zum Verbergen verbündeter Streitkräfte erzeugen. Die Bomber des Trägers Essex können Minenfelder abwerfen, um gegnerische Streitkräfte abzuschrecken."

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Die Gefechte werden im Modus „Herrschaft“ ausgetragen."

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_2_TEXT_1"
msgstr "An den Gefechten nehmen zwei Teams mit jeweils neun Schiffen teil. Spieler können an einem Gefecht entweder allein oder in einer Division aus bis zu drei Spielern teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE021_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Alle Schiffstypen der Stufen IX–X sind teilnahmeberechtigt. An den Gefechten können Flugzeugträger mit den neuen Verbrauchsmaterialien teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_HEADER"
msgstr "Zu den Höhen der Meisterschaft"

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie werden in einem Wettbewerb, der aus 5 Runden besteht, gegen andere Spieler antreten."

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_1_TEXT_2"
msgstr "In jeder Runde nehmen Sie an einem der zufällig ausgewählten Tests teil: „Kampfausdauer“, „Schnelle Manöver“, „Feuerkraft“, „Zielvernichtung“ und „Schussgenauigkeit“."

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_1_TEXT_3"
msgstr "In den verschiedenen Tests werden bestimmte Änderungen und Einschränkungen auf die Eigenschaften Ihres Schiffs angewendet. Während des gesamten Wettbewerbs können Sie kein Verbrauchsmaterial verwenden."

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_1_TEXT_4"
msgstr "Nach jeder Runde wird die Rangliste aktualisiert und der Spieler mit dem schlechtesten Ergebnis scheidet aus dem Wettbewerb aus. Bei zwei Spielern mit demselben Ergebnis erhält derjenige den höheren Platz in der Tabelle, der dieses Ergebnis zuerst erreicht hat."

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE022_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können allein oder in einer Division mit bis zu 3 Teilnehmern ins Gefecht gehen."

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_HEADER"
msgstr "Asymmetrisches Gefecht"

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Unzählige Horden von Echsenwesen führen ihre gewaltigen Schiffe zum Angriff ... Ihnen stellt sich nur eine Handvoll Russen auf ihren treuen Booten entgegen."

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Doch nicht alles ist verloren: Nachdem sie vom Wasser des Baikalsees getrunken haben, erhielten die großen Russen eine Ladung heldenhafter Kühnheit, die helfen wird, die Reptilien zu besiegen!"

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE023_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können allein oder in einer Division mit bis zu 3 Teilnehmern an einem Gefecht teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE024_RULES_HEADER"
msgstr "Konvoi"

msgid "IDS_MODAL_WINDOW_PCVE024_RULES_PARAGRAPH_1_HEADER"
msgstr "Regeln und Merkmale"

msgid "IDS_MODAL_WINDOW_PCVE024_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Wenn Sie einem Gefecht beitreten, werden Sie nach dem Zufallsprinzip entweder dem Angreifer- oder dem Verteidigerteam zugewiesen."

msgid "IDS_MODAL_WINDOW_PCVE024_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Das Verteidigerteam hat den Auftrag, entweder die sichere Ankunft von mindestens einem Transportschiff am Zielpunkt sicherzustellen oder alle Schiffe des Angreiferteams zerstören."

msgid "IDS_MODAL_WINDOW_PCVE024_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Das Angreiferteam muss unter allen Umständen verhindern, dass die Transportschiffe ihren Zielpunkt erreichen oder es muss alle Schiffe des Verteidigerteams zerstören."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_HEADER"
msgstr "Luftschiff-Eskorte"

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Jedes Team hat die Aufgabe, entweder sein verbündetes Luftschiff noch vor dem des Gegnerteams zum Zielpunkt zu bringen oder alle Gegnerschiffe zu zerstören."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Beide Luftschiffe bewegen sich kontinuierlich, aber jedes Team kann ihre Reisegeschwindigkeit beeinflussen. Ein Luftschiff bewegt sich mit höherer Geschwindigkeit, wenn nur verbündete Schiffe in der Nähe sind; ein Luftschiff wird langsamer, wenn sich mindestens ein feindliches Schiff anschleicht und in der Nähe bleibt."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Das Luftschiff erreicht seine Höchstgeschwindigkeit, wenn das verbündete Team gleichzeitig das gegnerische Luftschiff verlangsamt und das eigene Luftschiff beschleunigt."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_1_TEXT_4"
msgstr "Die Schnelligkeit eines Luftschiffs hängt nicht von der Anzahl der Schiffe desselben Teams ab, die sich neben ihm befinden."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Im Gefecht treten zwei Teams mit je 12 Schiffen gegeneinander an. Sie können entweder allein oder in einer Division mit bis zu drei Teilnehmern ins Gefecht ziehen."

msgid "IDS_MODAL_WINDOW_PCVE025_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Schiffe der Stufen VIII–X können teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_HEADER"
msgstr "Verdeckte Manöver"

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Flugzeuge können ein gegnerisches Schiff nur in dem Bereich um den Flugzeugträger oder das Hybridschiff herum erkennen, von dem diese Flugzeuge gestartet sind."

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Wenn sie weit vom Trägerschiff entfernt sind, können Flugzeuge ein gegnerisches Schiff nur erkennen, wenn sie in den Wirkungsbereich seiner Flugabwehr gelangen."

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE026_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können allein oder in einer Division mit bis zu drei Spielern an einem Gefecht teilnehmen."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_HEADER"
msgstr "Ära der Panzerschiffe"

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie müssen alle feindlichen Schiffe zerstören oder die Basis erobern."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Zerstörer, die vernichtet wurden, kehren nach einiger Zeit ins Gefecht zurück. Vernichtete Zerstörer können nicht zurückkehren, wenn im Team keine Schlachtschiffe und Kreuzer mehr übrig sind."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_2_HEADER"
msgstr "Zerstörung der Panzerung"

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Panzerung wird durch Schaden zerstört."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Wenn ein Panzerungselement vollständig zerstört ist, kann eine Granate einen verwundbaren Teil des Schiffs treffen und beträchtlichen Schaden verursachen."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_3_HEADER"
msgstr "Mittelkaliber"

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Neben der Hauptbatterie und der Mittelkalibergeschütze sind einige gepanzerte Schiffe mit Mittelkalibergeschützen bewaffnet."

msgid "IDS_MODAL_WINDOW_PCVE027_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Im Vergleich zur Hauptbatterie laden Mittelkalibergeschütze schneller, verursachen aber weniger Schaden."

msgid "IDS_MODAL_WINDOW_PCVE028_BATTLE_RULES_HEADER"
msgstr "Na warte!"

msgid "IDS_MODAL_WINDOW_PCVE028_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "ERZIELEN DER PUNKTE"

msgid "IDS_MODAL_WINDOW_PCVE028_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr ""
"Goldenes Ei: +30\n"
"Weißes Ei: +10\n"
"Hai: -20"

msgid "IDS_MODAL_WINDOW_PCVE028_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "WELLENSTREUER"

msgid "IDS_MODAL_WINDOW_PCVE028_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Wellen versenken Eier und Haie und zerstören außerdem Wellen, die von gegnerischen Schiffen ausgesendet wurden."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_HEADER"
msgstr "Auf die Plätze!"

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_1_HEADER"
msgstr "Teamauftrag"

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie müssen so viele Punkte wie möglich sammeln, indem Sie Eier fangen."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Goldene Eier bringen mehr Punkte als weiße. Wenn ein Hai Sie rammt, verlieren Sie Punkte."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_2_HEADER"
msgstr "Wellenstreuer"

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Jedes Schiff ist mit einem Wellenstreuer ausgestattet."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Damit können Sie Eier und Haie versenken sowie Wellen zerstören, die von anderen Schiffen abgefeuert werden."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_3_HEADER"
msgstr "Belohnungen"

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Für die Plätze 1, 2 und 3 gibt es Andenken-Errungenschaften."

msgid "IDS_MODAL_WINDOW_PCVE028_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Je höher Ihr Ergebnis, desto mehr Ressourcen erhalten Sie nach dem Gefecht."

msgid "IDS_MODAL_WINDOW_PCVE029_BATTLE_RULES_HEADER"
msgstr "U-Boote"

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_HEADER"
msgstr "U-Boot-Schwelle"

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie können mit einem U-Boot am Gefecht teilnehmen, um die geänderten Eigenschaften dieser Klasse zu erleben."

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Wenn Sie mit einem Schiff einer anderen Klasse ins Gefecht gehen, können Sie die geänderten U-Boot-Abwehrmittel testen."

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_2_HEADER"
msgstr "U-Boote"

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sonar und akustische Torpedos sind kombiniert: Nach einem Sonartreffer auf ein Schiff wechselt die Bewaffnung automatisch. Ein Sonartreffer ermöglicht den Abschuss eines Torpedos."

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Das Verbrauchsmaterial „Hydrofon“ ist nicht verfügbar. Alle U-Boote führen auf Sehrohr- und Betriebstiefe ständig Schallpeilung durch."

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_3_HEADER"
msgstr "Überwasserschiffe"

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Wasserbomben verbleiben für eine bestimmte Zeit in geringer Tiefe und explodieren in der Nähe von Schiffen, U‑Booten und Torpedos."

msgid "IDS_MODAL_WINDOW_PCVE029_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Neben der Schadensverursachung an getauchten U‑Booten zerstören die Bomben auch Torpedos und fügen Überwasserschiffen sowie aufgetauchten U‑Booten geringen Schaden zu."

msgid "IDS_MODAL_WINDOW_PCVE030_BATTLE_RULES_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_HEADER"
msgstr "Waffenträger: Isolation"

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie können auf der Seite von Ermelinda Jung, der Kommandantin mächtiger Schiffe, oder der Hounds – der Jäger der Allianz – in den Kampf ziehen. Jede Seite hat ihre eigene Taktik, ihre eigenen Ziele und ihre eigene Wahrheit."

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Zu Beginn des Gefechts stehen alle Punkte unter der Kontrolle von Ermelinda. Auf der Karte gibt es Portale, mit denen Sie zum gegenüberliegenden Teil des Schlachtfelds wechseln können."

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_2_HEADER"
msgstr "Ermelinda: Vergeltungsprotokoll"

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Ziel der Ermelinda ist es, den Hounds mit einem Evakuierungssystem zu entkommen, das durch die Eroberung von Punkten und die Vernichtung der Hounds aufgeladen wird. Jeder eroberte Punkt unterstützt auch das Schildmodul des Schiffs der Ermelinda."

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Ermelinde stehen drei Schiffe zur Verfügung, jedes mit einer einzigartigen Bewaffnung und einer besonderen taktischen Rolle."

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_3_HEADER"
msgstr "Hounds: die Bluthunde der Allianz"

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Die Allianz verfügt über Regenerationstechnologie: Alle zerstörten Hounds können ins Gefecht zurückkehren."

msgid "IDS_MODAL_WINDOW_PCVE030_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Die Hounds müssen Schlüsselbereiche erobern, um das Schildmodul der Ermelinda zu zerstören und sie zu vernichten, bevor sie das Evakuierungssystem starten kann."

msgid "IDS_MODAL_WINDOW_PCVE031_BATTLE_RULES_HEADER"
msgstr "Kosmische Front"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_HEADER"
msgstr "Kosmische Front"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Die Aufgabe jedes Teams ist es, die gegnerische Basis zu zerstören."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Nur das Superschlachtschiff Beowulf kann Basen Schaden zufügen – um es zu beschwören, müsst ihr Gegner zerstören. Beschützt das verbündete Superschlachtschiff und lasst nicht zu, dass das gegnerische Superschlachtschiff eure Basis zerstört. Beowulf kann unbegrenzt oft beschworen werden."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_2_HEADER"
msgstr "Respawns"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Falls ihr zerstört werdet, kehrt ihr ins Gefecht zurück, indem ihr eine Position und ein Schiff auswählt. Dabei sind einige Schiffe nur gegen im Gefecht verdiente Respawn-Punkte verfügbar. Nicht genutzte Punkte verfallen am Ende des Gefechts."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_3_HEADER"
msgstr "Raketen, Laser und Energieschilde"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Schiffe können mit zwei Raketentypen ausgerüstet sein: zielsuchende und ferngesteuerte. Bevor ihr eine zielsuchende Rakete abfeuert, müsst ihr das Ziel scannen. Ferngesteuerte Raketen verursachen hohen Schaden, beschädigen aber keine Energieschilde."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Um eine anfliegende gegnerische Rakete abzufangen, müsst ihr rechtzeitig den Abwehrlaser aktivieren."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_3_TEXT_3"
msgstr "Alle Schiffe sind durch Energieschilde geschützt – sie regenerieren sich, solange sie keinen Schaden erleiden. Wenn ein Energieschild zerstört ist, kann er sich nicht mehr regenerieren, und das Schiff wird verwundbar."

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_4_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE031_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Ihr könnt mit speziellen Kreuzern, Schlachtschiffen und Zerstörern der Stufe X ins Gefecht ziehen."

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_HEADER"
msgstr "Auf der Suche nach Pandora"

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "UNSERE AUFGABE"

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sammle 1000 Punkte und bleibe nicht ganz ohne sie. Schiffe kehren zurück, bis jemand gewinnt oder die Zeit abläuft."

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "BÜCHSE DER PANDORA"

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "An verschiedenen Stellen der Karte erscheinen mysteriöse Kisten – sie können den Verlauf der Schlacht wenden. Zu wessen Gunsten? Gute Frage..."

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "TRUMPFKARTEN IM ÄRMEL"

msgid "IDS_MODAL_WINDOW_PCVE032_BATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "U-Boote mit neuem Verbrauchsmaterial helfen ihrem Team selbst in den schwierigsten Zeiten. Für den Gegner haben sie Minen."

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_HEADER"
msgstr "Auf der Suche nach Pandora"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_1_HEADER"
msgstr "Trümpfe im Ärmel"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_1_TEXT_1"
msgstr "U-Boote können Minenfelder legen und Zonen mit Verstärkungen für Verbündete schaffen. Kombinieren Sie Taktiken für maximale Effektivität und lassen Sie die Gegner erzittern!"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Alle zerstörten Schiffe können ins Gefecht zurückkehren."

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_2_HEADER"
msgstr "Pandoras Büchse"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Auf dem Schlachtfeld erscheinen regelmäßig geheimnisvolle Kisten. Wer sich ihnen zu nähern wagt, wird Pandoras Segen oder Fluch erfahren und den Verlauf der Schlacht im Handumdrehen verändern."

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Testen Sie Ihr Glück!"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_3_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Sie können in Gefechten auf Schlachtschiffen, Kreuzern und Zerstörern der Stufe VIII sowie auf zwei U-Booten mit neuem Verbrauchsmaterial und neuer Bewaffnung antreten."

msgid "IDS_MODAL_WINDOW_PCVE032_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Die U-Boote „Leninez“ und Stingray wurden Ihnen für die Teilnahme am Event leihweise überlassen."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_HEADER"
msgstr "Aggression"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Es wird zufällig einer von zwei Modi ausgewählt: „Epizentrum“ oder „Hinter feindlichen Linien“. Ihre Aufgabe in beiden Modi ist es, 1000 Punkte zu sammeln oder alle gegnerischen Schiffe zu zerstören."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_2_HEADER"
msgstr "Epizentrum"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Auf dem Schlachtfeld gibt es drei Schlüsselbereiche, die Epizentrum-Zonen genannt werden. Einer davon ist ein Kreis, die anderen beiden sind Ringe, die um den ersten herum angeordnet sind."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Alle drei Epizentrumszonen werden unabhängig voneinander erobert."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_3_HEADER"
msgstr "Hinter den feindlichen Linien"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Auf der Karte gibt es zwei Schlüsselbereiche, die zu Beginn des Gefechts bereits den Teams gehören und nicht erobert werden können. Jedes Team startet das Gefecht von der Seite des gegnerischen Schlüsselbereichs aus."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_3_TEXT_2"
msgstr "5 Minuten nach Beginn des Gefechts werden die Punkte für die Eroberung freigegeben und beginnen zu schrumpfen."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_4_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Sie können mit einem Schiff der Stufe VIII oder IX ins Gefecht gehen. Alle Klassen sind erlaubt."

msgid "IDS_MODAL_WINDOW_PCVE033_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Teamgröße: 12 gegen 12. Maximale Divisionsgröße: 3."

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_HEADER"
msgstr "Hydras Versteck"

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_1_HEADER"
msgstr "Einsatzplan"

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Die Flammen der Schlacht verglimmen – der Feind windet sich in Agonie, die Verbündeten treiben ihn bis in sein Versteck. Im letzten Hafen, der noch unter Kontrolle des Gegners steht, sammeln sich die Überreste seiner Flotte. Sie bereiten sich auf den Rückzug vor – der letzte Zucken eines sterbenden Tieres."

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Die Aufklärung meldet, dass die Schlachtschiffe der Gruppe „Horst“ sich zum Rückzug aus dem Hafen bereit machen."

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_1_TEXT_3"
msgstr "Ihre Aufgabe ist es, die Reste der feindlichen Streitkräfte zu vernichten, die den Hafen verlassen."

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Sie können mit einem Schiff der Stufe VI–X oder einem Superschiff ins Gefecht ziehen. Alle Schiffsklassen mit Ausnahme von U-Booten sind zugelassen."

msgid "IDS_MODAL_WINDOW_PCVO006_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Teamgröße: 7. Maximale Divisionsgröße: 7."

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_HEADER"
msgstr "Die letzte Fahrt der Transylvania"

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Das Portal zur dunklen Dimension hat sich wieder geöffnet! Unsagbar böse Kräfte dringen in unsere Welt vor. Das Schlachtfeld ist vollkommen vom Schmutz umzingelt. Alle verbündeten Schiffe, die hineinfahren, verlieren kontinuierlich Trefferpunkte, während gegnerische Truppen dort widerstandsfähiger gegen Schaden werden."

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Die Transylvania erzeugt einen magischen Bereich um sich herum, der den Schmutz abwehrt. Doch die Magie wird schwächer und der sichere Bereich schrumpft im Laufe der Zeit immer weiter."

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_2_HEADER"
msgstr "Ziel"

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Nur die Transylvania kann dieser Saga ein Ende bereiten. Sie müssen sie zum Portal geleiten, damit sie es ausradieren kann."

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_3_HEADER"
msgstr "Buffs"

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Im Gefecht wird Ihr Schiff mit einem Modifikator versehen, der seine Gefechtseigenschaften verändert. Sie erhalten ebenfalls Buffs für jeden zerstörten Verbündeten."

msgid "IDS_MODAL_WINDOW_PCVO031_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Indem Sie Scherben der großen Türme sammeln, können Sie den Widerstand der Transylvania gegen Schaden erhöhen."

msgid "IDS_MODAL_WINDOW_PCVO032_BATTLE_RULES_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVO032_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "GEGNER"

msgid "IDS_MODAL_WINDOW_PCVO032_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Zerstöre Bots auf Schiffen aus der Ära der Panzerschiffe. Die Anzahl der Gegner steigt ständig!"

msgid "IDS_MODAL_WINDOW_PCVO032_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "BUFFS"

msgid "IDS_MODAL_WINDOW_PCVO032_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "An den Stellen einiger zerstörter Gegner erscheinen Buffs. Sammeln Sie diese, solange sie verfügbar sind!"

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_HEADER"
msgstr "Eiserne Horde"

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie kämpfen gegen eine Horde Bots auf Schiffen aus der Zeit der Panzerschiffe. Die Anzahl der Gegner steigt ständig an."

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Ihre Aufgabe: Sammeln Sie 1000 Punkte, indem Sie gegnerische Schiffe zerstören."

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_2_HEADER"
msgstr "Buffs"

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Im Gefecht werden Ihnen Gegner mit Verbesserungen begegnen."

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Wenn Sie ein solches Schiff zerstören, können Sie die Verbesserung für eine begrenzte Zeit aufnehmen."

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_3_HEADER"
msgstr "Module"

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Bei einigen Schiffen können Module ausgewählt werden."

msgid "IDS_MODAL_WINDOW_PCVO032_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Durch den Wechsel von Modulen können Sie den Granatentyp für die Haupt- und Mittelkalibergeschütze wählen."

msgid "IDS_MODAL_WINDOW_PCVT001_DAMAGE_PRIME_BATTLE_RULES_HEADER"
msgstr "FEUERKRAFT"

msgid "IDS_MODAL_WINDOW_PCVT002_CITADEL_PRIME_BATTLE_RULES_HEADER"
msgstr "SCHUSSGENAUIGKEIT"

msgid "IDS_MODAL_WINDOW_PCVT003_FRAGS_PRIME_BATTLE_RULES_HEADER"
msgstr "ZIELVERNICHTUNG"

msgid "IDS_MODAL_WINDOW_PCVT004_MANEUVER_PRIME_BATTLE_RULES_HEADER"
msgstr "Manöver auf einem Zerstörer"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_5"
msgstr "Sie sind erfolgreich durch das Portal verschwunden!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_6"
msgstr "Sie sind der einzige Überlebende!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_7"
msgstr "Ihr Schiff wurde zerstört."

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_5"
msgstr "Sie sind erfolgreich durch das Portal verschwunden!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_6"
msgstr "Sie sind der Champion des Oktagons!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_7"
msgstr " "

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_HAS_PREM"
msgstr "Premiumkonto"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_5"
msgstr "So ist es richtig!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_6"
msgstr "So ist es richtig!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_7"
msgstr "Ihr Schiff wurde zerstört."

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_REWARD_TITLE"
msgstr "Ihre Belohnung nach Gefechtsende:"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_TITLE"
msgstr "Ihre Wertung"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_RESULTS_TITLE"
msgstr "Gefechtsbelohnung"

msgid "IDS_MODAL_WINDOW_PURCHASE_AND_LINK_MULTIBOOST"
msgstr "Boni kaufen"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_HEADER"
msgstr "Unternehmen"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie kämpfen zusammen mit anderen Spielern gegen Bots. Jedes Unternehmen hat seine eigenen Storyelemente."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Es wird ein zufälliges Unternehmen ausgewählt. Die Komplexität hängt von den Stufen und Typen der Schiffe in Ihrem Team ab."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Aufgaben"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Um zu gewinnen, muss Ihr Team die Hauptaufgabe erfüllen."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Je mehr Nebenaufgaben Sie im Unternehmen abschließen, desto mehr Ressourcen erhalten Sie."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_HEADER"
msgstr "Zufallsgefecht"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Kämpfen Sie zusammen mit anderen Spielern in einem Gefecht zwischen zwei Teams."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Karte und Gefechtsmodus werden zufällig ausgewählt."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Teilnahmeregeln"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Die maximale Teamgröße hängt von den Stufen der Schiffe ab:"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "• Stufen I–III: 6 gegen 6;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "• Stufe IV: 6 gegen 6 oder 9 gegen 9;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_4"
msgstr "• Stufe V–VI: 9 gegen 9 oder 12 gegen 12;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_5"
msgstr "• Stufe VII–X und Superschiffe: 12 gegen 12."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_HEADER"
msgstr "Gewertetes Gefecht"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie kämpfen mit anderen Spielern, erhalten Ränge und steigen in Ligen auf."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Die Saison der gewerteten Gefechte ist in Sprints aufgeteilt. Ihr Fortschritt in der Liga wird zu Beginn jedes Sprints zurückgesetzt."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Bedingungen der Saison"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Bronzeliga"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Silberliga"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Goldliga"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Ligen und Ränge"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Um in die nächste Liga aufzusteigen, müssen Sie Rang 1 erreichen und die Qualifikation bestehen."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Um Ränge zu erhalten, müssen Sie Sterne verdienen."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Sterne"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Für einen Sieg erhalten Sie einen Stern. Für eine Niederlage oder ein Unentschieden verlieren Sie einen Stern."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Sie verlieren keinen Stern, wenn Sie nach dem Gefecht den 1. Platz in Ihrem Team nach verdienter Erfahrung belegen."

msgid "IDS_MODAL_WINDOW_RARE_CREW_MANUAL_HEADER"
msgstr "Verleihung eines seltenen Kapitänshandbuchs"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_HEADER"
msgstr "Rating-Gefecht"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Gefechtsmerkmale"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Sie treten gegen andere Spieler an, die nach ihrem Gefechtseffizienz-Rating zusammengestellt werden."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Das Rating wird nach jedem Gefecht basierend auf dessen Ergebnis und der erhaltenen Basis-EP angepasst."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Ligen und Rating"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Der Fortschritt in Ranglistengefechten wird jede Saison zurückgesetzt. Zu Beginn einer Saison müssen Sie 5 Gefechte absolvieren, um ein Rating in einer der Ligen zu erhalten."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Der maximale Rating in der Eisen-, Bronze-, Silber- und Goldliga beträgt 100. Wenn Sie diesen Wert in der aktuellen Liga überschreiten, steigen Sie in die nächste auf. In der Obsidianliga können Sie den Rating unbegrenzt erhöhen."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Divisionen"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Der Divisionsrating ist der durchschnittliche Rating aller Teilnehmer mit einem steigenden Multiplikator basierend auf der Anzahl. Je mehr Teilnehmer in der Division sind, desto höher der Multiplikator."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Bei der Gegnersuche werden sowohl der Rating der Spieler als auch der Rating der Divisionen berücksichtigt."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Teilnahmebedingungen"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Die Teamzusammensetzung kann je nach Saison variieren."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Sie können allein oder als Teil einer Division am Gefecht teilnehmen. Die Größe der Division ist nur durch die Teamgröße begrenzt."

msgid "IDS_MODAL_WINDOW_RULES_ACHIEVEMENT_HEADER"
msgstr "Errungenschaften"

msgid "IDS_MODAL_WINDOW_SEASON_RESTRICTIONS_TITLE"
msgstr "Spezifische Schiffseinschränkungen"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_ALL_ROLES"
msgstr "Alle Rollen ansehen"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_MAIN"
msgstr "Übersicht"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_OTHER"
msgstr "Details"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TITLE"
msgstr "Schiffsbesonderheiten"

msgid "IDS_MODAL_WINDOW_SHIP_BRANCH_FEATURES_TITLE"
msgstr "Schiffsbesonderheiten"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_HEADER"
msgstr "Meisterschaft"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_HEADER"
msgstr "Meisterschaftsniveau"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Meisterschaft spiegelt wider, wie gut Sie ein bestimmtes Schiff beherrschen und welche Kampferfahrung Sie damit haben. Der Meisterschaftsgrad wird neben dem Schiffsnamen angezeigt."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Nur für Schiffe der Stufen V–X und Super-Schiffe verfügbar."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_HEADER"
msgstr "Fortschritt"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Um zum nächsten Meisterschaftsgrad aufzusteigen, müssen Sie eine bestimmte Menge an Basis-EP sammeln."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Je höher die Schiffstufe und Ihr Meisterschaftsgrad auf diesem Schiff sind, desto mehr Basis-EP müssen Sie sammeln, um zum nächsten Meisterschaftsgrad zu gelangen."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_HEADER"
msgstr "Prüfungen"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Um jeden 10. Meisterschaftsgrad zu erreichen, müssen Sie Herausforderungen bestehen, die für jedes Schiff entsprechend seiner taktischen Rolle ausgewählt werden."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Sie können die Herausforderungen jederzeit zurücksetzen und neue erhalten."

msgid "IDS_MODAL_WINDOW_SHIP_PURCHASE_SHIP_PRICE"
msgstr "Kosten für das Schiff"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_HEADER"
msgstr "Erhaltbedingungen"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_HEADER"
msgstr "So erhalten Sie Belohnungen"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Jedem sowjetischen Schiff in Ihrem Hafen, von Stufe III bis zu Superschiffen, wurde eine festliche Belohnung gutgeschrieben. Um eine Belohnung von einem Schiff abzuholen, müssen Sie mit diesem Schiff ein Gefecht bestreiten und 300 Basis-EP verdienen oder einen Sieg erringen."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Nach Abschluss des Events verfallen nicht abgeholte Belohnungen ohne Entschädigung."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_HEADER"
msgstr "Mehr Belohnungen pro Gefecht"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Wenn Sie mit einem mit einer Belohnung versehenen Schiff mehr Basis-EP in einem Gefecht verdienen, können Sie Belohnungen von anderen Schiffen einlösen, ohne mit diesen in ein Gefecht zu gehen."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Je mehr Schiffe sich in Ihrem Hafen befinden, desto größer ist die maximale Anzahl von Belohnungen, die Sie nach einem einzigen Gefecht abholen können."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_3"
msgstr ""
"• 100 Schiffe: +1 Belohnung für 350 EP;\n"
"• 200 Schiffe: +2 Belohnungen für 400 EP;\n"
"• 300 Schiffe: +3 Belohnungen für 450 EP."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_3_HEADER"
msgstr "Anzahl der Belohnungen"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_BUTTON"
msgstr "Tutorial"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_HEADER"
msgstr "Verteidigung der Arktis"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_1_HEADER"
msgstr "In die Geschichte eintauchen"

