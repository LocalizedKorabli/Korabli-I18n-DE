msgstr "Die Bonuspunkte werden im nächsten Abschnitt berücksichtigt."

msgid "IDS_MODAL_WINDOW_TRIALBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Belohnungen"

msgid "IDS_MODAL_WINDOW_TRIALBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Je mehr Abschnitte Sie durchlaufen, desto mehr Ressourcen erhalten Sie am Ende der Prüfung."

msgid "IDS_MODAL_WINDOW_TRIALBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Belohnungen werden für jeden abgeschlossenen Abschnitt vergeben. Sie erhalten keine Belohnung für einen Abschnitt, wenn Sie ihn vorzeitig verlassen."

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "ABSCHNITTE"

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Schließen Sie die Aufgabe des aktuellen Abschnitts ab, um zum nächsten zu gelangen. Je mehr Abschnitte Sie durchlaufen, desto mehr Ressourcen erhalten Sie am Ende der Prüfung."

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "REGELN"

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "In den Prüfungen können Einschränkungen für die Verwendung von Bewaffnung und Verbrauchsmaterial sowie für die Schiffssteuerung gelten."

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "MARKEN"

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Feuern Sie auf markierte Ziele, um mehr Punkte zu erhalten. Verwenden Sie den angegebenen Waffentyp oder verursachen Sie den angegebenen Schadenstyp."

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_5_HEADER"
msgstr "PUNKTE"

msgid "IDS_MODAL_WINDOW_TRIALS_BATTLE_RULES_PARAGRAPH_5_TEXT_1"
