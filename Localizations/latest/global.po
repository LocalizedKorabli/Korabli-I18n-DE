msgid "IDS_PCEE119_GRAF_ZEPPELIN_DESCRIPTION"
msgstr "Man muß nur wollen und daran glauben, dann wird es gelingen."

msgid "IDS_PCEE120_SUMMER_FEST_2017"
msgstr "Summer Fest 2017"

msgid "IDS_PCEE120_SUMMER_FEST_2017_DESCRIPTION"
