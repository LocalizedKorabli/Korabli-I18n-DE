msgstr "Wählen Sie ein Schiff passender Stufe."

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_TOURNAMENT"
msgstr "Wählen Sie ein Schiff passender Stufe."

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_TRAINING"
msgstr "Wählen Sie ein Schiff passender Stufe."

msgid "IDS_THIS_SHIP_LEVEL_IS_NOT_ALLOWED_FOR_TRIAL"
msgstr "Das ausgewählte Schiff ist von der Stufe her nicht für Trainingsprüfungen geeignet."

